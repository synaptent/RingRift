[Unit]
Description=RingRift P2P Orchestrator
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/ringrift/ai-service
Environment=PYTHONPATH=/root/ringrift/ai-service
EnvironmentFile=-/etc/ringrift/node.conf
ExecStartPre=/bin/bash -c 'cd /root/ringrift && git pull origin main 2>/dev/null || true'
ExecStart=/root/ringrift/ai-service/venv/bin/python scripts/p2p_orchestrator.py --node-id ${NODE_ID} --port 8770 --advertise-host ${ADVERTISE_HOST} --peers ${PEER_LIST} --ringrift-path /root/ringrift
Restart=always
RestartSec=10
StandardOutput=append:/root/ringrift/ai-service/logs/p2p.log
StandardError=append:/root/ringrift/ai-service/logs/p2p.log

# Mar 27, 2026: Kill ALL descendant processes on stop/restart.
# Previous behavior left orphan selfplay processes (28+ procs × 80 threads each)
# that accumulated across P2P restarts until the node hit NPROC limits
# ("Resource temporarily unavailable" on gh200-12, required reboot).
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=30
ExecStopPost=/bin/bash -c 'pkill -9 -f "selfplay|gumbel_mcts|run_gpu_selfplay|generate_gumbel" 2>/dev/null || true'

# Resource limits — orchestrator itself is light but its children use GPU
# MemoryMax removed: was 2G which caused OOM kills that left orphans
CPUQuota=50%
LimitNPROC=8192
TasksMax=200000

# Watchdog
WatchdogSec=300
NotifyAccess=all

[Install]
WantedBy=multi-user.target
