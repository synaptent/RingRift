[Unit]
Description=RingRift P2P Orchestrator
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ringrift/ai-service
Environment=PYTHONPATH=/home/ubuntu/ringrift/ai-service
EnvironmentFile=-/etc/ringrift/node.conf
ExecStartPre=/bin/bash -c 'cd /home/ubuntu/ringrift && git pull origin main 2>/dev/null || true'
ExecStart=/home/ubuntu/ringrift/ai-service/venv/bin/python scripts/p2p_orchestrator.py --node-id ${NODE_ID} --port 8770 --advertise-host ${ADVERTISE_HOST} --peers ${PEER_LIST} --ringrift-path /home/ubuntu/ringrift
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/ringrift/ai-service/logs/p2p.log
StandardError=append:/home/ubuntu/ringrift/ai-service/logs/p2p.log

# Mar 27, 2026: Kill descendant processes via systemd cgroup only.
# A later broad ExecStopPost pkill pattern also matched independent role
# services (policy selfplay workers), so the cgroup boundary is the safe and
# sufficient cleanup mechanism here.
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=30

# Resource limits — orchestrator itself is light but its children use GPU
# MemoryMax removed: was 2G which caused OOM kills that left orphans
CPUQuota=50%
LimitNPROC=8192
TasksMax=200000

# Watchdog
WatchdogSec=300
NotifyAccess=all

[Install]
WantedBy=multi-user.target
