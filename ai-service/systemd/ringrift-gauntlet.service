[Unit]
Description=RingRift Gauntlet Evaluation Runner
After=network.target
# Explicitly NOT dependent on ringrift-p2p so it survives P2P restarts

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ringrift/ai-service
Environment=PYTHONPATH=/home/ubuntu/ringrift/ai-service
EnvironmentFile=/etc/ringrift/node.conf
ExecStart=/home/ubuntu/ringrift/ai-service/venv/bin/python /home/ubuntu/ringrift/ai-service/scripts/gauntlet_runner.py
Restart=always
RestartSec=30
Nice=10
# KillMode=control-group: kill ALL children (game workers, torch processes)
# Prevents zombie accumulation that crashed gh200-8 on Mar 23.
KillMode=control-group
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
