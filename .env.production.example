# =============================================================================
# RingRift Production Environment Template
# =============================================================================
#
# Copy to `.env.production`, replace placeholder values, and keep the real file
# out of version control. This template tracks variables currently consumed by
# the server, client build, or production docker-compose stack.

# -----------------------------------------------------------------------------
# Core server runtime
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
RINGRIFT_RULES_MODE=ts
RINGRIFT_APP_TOPOLOGY=single

# -----------------------------------------------------------------------------
# Database and Redis
# -----------------------------------------------------------------------------
POSTGRES_DB=ringrift
POSTGRES_USER=ringrift
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
DATABASE_URL=postgresql://ringrift:REPLACE_WITH_SECURE_PASSWORD@postgres:5432/ringrift

REDIS_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_SECURE_PASSWORD@redis:6379
REDIS_TLS=false

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
JWT_SECRET=REPLACE_WITH_48_CHAR_MINIMUM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_48_CHAR_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Public URLs and CORS
# -----------------------------------------------------------------------------
CLIENT_URL=https://ringrift.example.com
CORS_ORIGIN=https://ringrift.example.com
ALLOWED_ORIGINS=https://ringrift.example.com,https://www.ringrift.example.com

# -----------------------------------------------------------------------------
# AI service
# -----------------------------------------------------------------------------
AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_REQUEST_TIMEOUT_MS=30000
AI_RULES_REQUEST_TIMEOUT_MS=5000
AI_MAX_CONCURRENT_REQUESTS=100
AI_FALLBACK_ENABLED=true
ENABLE_SANDBOX_AI_ENDPOINTS=true

# -----------------------------------------------------------------------------
# Orchestrator health thresholds
# -----------------------------------------------------------------------------
ORCHESTRATOR_CIRCUIT_BREAKER_ENABLED=true
ORCHESTRATOR_ERROR_THRESHOLD_PERCENT=5
ORCHESTRATOR_ERROR_WINDOW_SECONDS=300
ORCHESTRATOR_LATENCY_THRESHOLD_MS=500

# -----------------------------------------------------------------------------
# Monitoring / observability
# -----------------------------------------------------------------------------
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true
METRICS_PORT=9090
METRICS_API_KEY=
SENTRY_DSN=
VITE_SENTRY_DSN=
GRAFANA_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
GRAFANA_ROOT_URL=https://ringrift.example.com:3002

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Rate limits
# -----------------------------------------------------------------------------
RATE_LIMIT_API_POINTS=1000
RATE_LIMIT_API_AUTH_POINTS=200
RATE_LIMIT_AUTH_POINTS=100
RATE_LIMIT_AUTH_LOGIN_POINTS=10
RATE_LIMIT_AUTH_REGISTER_POINTS=5
RATE_LIMIT_GAME_POINTS=500
RATE_LIMIT_GAME_CREATE_USER_POINTS=10
RATE_LIMIT_GAME_CREATE_IP_POINTS=20

# -----------------------------------------------------------------------------
# Capacity
# -----------------------------------------------------------------------------
MAX_CONCURRENT_GAMES=150
