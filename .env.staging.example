# =============================================================================
# RingRift Staging Environment Template
# =============================================================================
#
# Copy to `.env.staging`, replace placeholder values, and keep the real file
# out of version control. This template tracks variables currently consumed by
# the server, client build, or staging docker-compose stack.

# ---------------------------------------------------------------------------
# Core server
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
RINGRIFT_RULES_MODE=ts
RINGRIFT_APP_TOPOLOGY=single

# ---------------------------------------------------------------------------
# Database (PostgreSQL + Prisma)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://ringrift:<STAGING_DB_PASSWORD>@postgres:5432/ringrift
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ringrift
DB_USER=ringrift
DB_PASSWORD=<STAGING_DB_PASSWORD>

POSTGRES_DB=ringrift
POSTGRES_USER=ringrift
POSTGRES_PASSWORD=<STAGING_DB_PASSWORD>

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<STAGING_REDIS_PASSWORD>

# ---------------------------------------------------------------------------
# JWT / Authentication
# ---------------------------------------------------------------------------
JWT_SECRET=<STAGING_JWT_SECRET_REPLACE_ME>
JWT_REFRESH_SECRET=<STAGING_JWT_REFRESH_SECRET_REPLACE_ME>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Public URLs / CORS
# ---------------------------------------------------------------------------
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# File storage and logging
# ---------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=./logs/app.log

# ---------------------------------------------------------------------------
# AI service
# ---------------------------------------------------------------------------
AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_PORT=8001
AI_SERVICE_REQUEST_TIMEOUT_MS=5000
AI_RULES_REQUEST_TIMEOUT_MS=5000
AI_MAX_CONCURRENT_REQUESTS=50
AI_FALLBACK_ENABLED=true
ENABLE_SANDBOX_AI_ENDPOINTS=true
RINGRIFT_TRAINED_HEURISTIC_PROFILES=/app/data/trained_heuristic_profiles.json

# ---------------------------------------------------------------------------
# Orchestrator health thresholds
# ---------------------------------------------------------------------------
ORCHESTRATOR_CIRCUIT_BREAKER_ENABLED=true
ORCHESTRATOR_ERROR_THRESHOLD_PERCENT=5
ORCHESTRATOR_ERROR_WINDOW_SECONDS=300
ORCHESTRATOR_LATENCY_THRESHOLD_MS=500

# ---------------------------------------------------------------------------
# Monitoring / observability
# ---------------------------------------------------------------------------
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true
METRICS_PORT=9090
METRICS_API_KEY=
SENTRY_DSN=
VITE_SENTRY_DSN=
GRAFANA_PASSWORD=<STAGING_GRAFANA_PASSWORD>
GRAFANA_ROOT_URL=http://localhost:3002

# ---------------------------------------------------------------------------
# Load testing / rate limits
# ---------------------------------------------------------------------------
MAX_CONCURRENT_GAMES=150

RATE_LIMIT_BYPASS_ENABLED=true
RATE_LIMIT_BYPASS_TOKEN=<STAGING_BYPASS_TOKEN_REPLACE_ME>
RATE_LIMIT_BYPASS_USER_PATTERN=^loadtest[._].+@loadtest\.local$
RATE_LIMIT_BYPASS_IPS=

RATE_LIMIT_API_POINTS=10000
RATE_LIMIT_API_AUTH_POINTS=10000
RATE_LIMIT_AUTH_POINTS=10000
RATE_LIMIT_AUTH_LOGIN_POINTS=10000
RATE_LIMIT_AUTH_REGISTER_POINTS=10000
RATE_LIMIT_GAME_POINTS=10000
RATE_LIMIT_GAME_CREATE_USER_POINTS=1000
RATE_LIMIT_GAME_CREATE_IP_POINTS=1000

# ---------------------------------------------------------------------------
# Client public env (optional overrides)
# ---------------------------------------------------------------------------
# VITE_API_URL=http://localhost:3000/api
# VITE_WS_URL=ws://localhost:3000
# VITE_ERROR_REPORTING_ENABLED=true
# VITE_ERROR_REPORTING_ENDPOINT=/api/client-errors
# VITE_ERROR_REPORTING_MAX_EVENTS=50
